{
    "name": "jardissupport/dbquery",
    "homepage": "https://jardis.io",
    "description": "Fluent SQL query builder with CTEs, window functions, subqueries, and JSON support for MySQL, MariaDB, PostgreSQL, and SQLite",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jardissupport/contracts": "^1.0 || ^2.0",
        "jardissupport/dotenv": "^1.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.2.9",
        "squizlabs/php_codesniffer": "3.13.6",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\DbQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\DbQuery\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/dbquery/issues",
        "docs": "https://docs.jardis.io/en/support/dbquery",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "database",
        "pdo",
        "query",
        "query-builder",
        "sql",
        "sql-builder",
        "php",
        "domain-driven-design",
        "hexagonal-architecture",
        "jardis",
        "jardissupport",
        "headgent"
    ]
}
